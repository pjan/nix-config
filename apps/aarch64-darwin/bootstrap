#!/usr/bin/env bash
# Prepare a new machine for its first build: restore the SSH keys the build needs from 1Password.
#
#   nix run .#bootstrap
#
#   ~/.ssh/id_ed25519_agenix  agenix identity; decrypts the secrets during activation
#   ~/.ssh/id_ed25519         read-only deploy key for pjan/nix-secrets (the `secrets` flake input);
#                             remove it once the 1Password SSH agent provides your GitHub key
#
# Signs in with the 1Password CLI only (sign-in address, email, Secret Key, password), so the
# 1Password app is not needed yet. Safe to re-run: a key that is already present with the expected
# fingerprint is kept, and the script stops rather than overwrite a different key.
set -euo pipefail

GREEN="$(printf '\033[1;32m')"
YELLOW="$(printf '\033[1;33m')"
RED="$(printf '\033[1;31m')"
NC="$(printf '\033[0m')"

SSH_DIR="${BOOTSTRAP_SSH_DIR:-$HOME/.ssh}" # override for testing
VAULT="Bootstrap"
SECRETS_REPO="git@github.com:pjan/nix-secrets.git"

# label | 1Password item (in $VAULT) | file in $SSH_DIR | expected fingerprint
KEYS=(
  "agenix identity|agenix|id_ed25519_agenix|SHA256:68bznSGYXYQxlJJcxePzP0hagjh+povm3+l0zNcAxUg"
  "nix-secrets deploy key|nix-secrets bootstrap|id_ed25519|SHA256:hIFAcfL6YDdvxmdPppBZ/f3m1/G6GQDmMMQ94xDFc0U"
)

die() {
  echo "${RED}$*${NC}" >&2
  exit 1
}

fingerprint() {
  ssh-keygen -lf "$1" | awk '{print $2}'
}

mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"

# GitHub host keys, from GitHub's API over HTTPS (macOS curl, so corporate TLS roots in the
# Keychain are trusted). Without them, the non-interactive fetch of `secrets` fails host key checks.
known_hosts="$SSH_DIR/known_hosts"
if ssh-keygen -F github.com -f "$known_hosts" >/dev/null 2>&1; then
  echo "${YELLOW}known_hosts:${NC} github.com already present"
else
  /usr/bin/curl -fsSL https://api.github.com/meta |
    jq -r '.ssh_keys[] | "github.com " + .' >>"$known_hosts"
  echo "${YELLOW}known_hosts:${NC} added github.com host keys"
fi

# Check every existing key before touching anything, so nothing is written on a conflict.
missing=()
for entry in "${KEYS[@]}"; do
  IFS='|' read -r label item file expected <<<"$entry"
  path="$SSH_DIR/$file"
  if [[ -e "$path" ]]; then
    actual="$(fingerprint "$path")" || die "$path exists but is not a readable SSH key; move it aside and re-run."
    [[ "$actual" == "$expected" ]] ||
      die "$path already exists with a different key ($actual, expected $expected). Not overwriting it; move it aside and re-run."
    echo "${YELLOW}$label:${NC} already present ($path)"
  else
    missing+=("$entry")
  fi
done

if ((${#missing[@]} > 0)); then
  added_account=false
  if ! op whoami >/dev/null 2>&1; then
    echo "${YELLOW}Sign in to 1Password${NC} (sign-in address, email, Secret Key, password):"
    if op account list --format json 2>/dev/null | jq -e 'length > 0' >/dev/null; then
      eval "$(op signin)"
    else
      eval "$(op account add --signin)"
      added_account=true
    fi
  fi

  tmp=""
  trap '[[ -n "$tmp" ]] && rm -f "$tmp"' EXIT
  for entry in "${missing[@]}"; do
    IFS='|' read -r label item file expected <<<"$entry"
    path="$SSH_DIR/$file"
    tmp="$(mktemp "$SSH_DIR/.bootstrap.XXXXXX")"
    op read --force --out-file "$tmp" --file-mode 0600 \
      "op://$VAULT/$item/private key?ssh-format=openssh" >/dev/null
    actual="$(fingerprint "$tmp")"
    [[ "$actual" == "$expected" ]] ||
      die "1Password item '$VAULT/$item' holds a different key ($actual, expected $expected); nothing written."
    mv -n "$tmp" "$path"
    tmp=""
    echo "${YELLOW}$label:${NC} restored to $path"
  done

  if [[ "$added_account" == true ]]; then
    op signout --forget >/dev/null 2>&1 || true
  fi
fi

# Prove the deploy key can read the secrets repository, exactly as the first build will.
GIT_SSH_COMMAND="ssh -F /dev/null -o IdentityAgent=none -o IdentitiesOnly=yes -i $SSH_DIR/id_ed25519 -o UserKnownHostsFile=$known_hosts -o StrictHostKeyChecking=yes" \
  git ls-remote "$SECRETS_REPO" HEAD >/dev/null ||
  die "Cannot read $SECRETS_REPO with $SSH_DIR/id_ed25519."
echo "${YELLOW}nix-secrets:${NC} readable with the deploy key"

echo "${GREEN}Bootstrap complete.${NC} Next: nix run .#build-switch"
