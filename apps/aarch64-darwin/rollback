#!/usr/bin/env bash
set -euo pipefail

GREEN="$(printf '\033[1;32m')"
YELLOW="$(printf '\033[1;33m')"
RED="$(printf '\033[1;31m')"
NC="$(printf '\033[0m')"

DARWIN_REBUILD=/run/current-system/sw/bin/darwin-rebuild

# Both listing (takes the system profile lock) and switching need root.
echo "${YELLOW}Available generations:${NC}"
sudo "$DARWIN_REBUILD" --list-generations

echo "${YELLOW}Enter the generation number for rollback:${NC}"
read -r GEN_NUM

if [[ ! "$GEN_NUM" =~ ^[0-9]+$ ]]; then
  echo "${RED}'${GEN_NUM}' is not a generation number. Aborting rollback.${NC}"
  exit 1
fi

echo "${YELLOW}Rolling back to generation $GEN_NUM...${NC}"
# Switches the system profile to an existing generation and activates it (no rebuild).
sudo "$DARWIN_REBUILD" --switch-generation "$GEN_NUM"

echo "${GREEN}Rollback to generation $GEN_NUM complete!${NC}"
